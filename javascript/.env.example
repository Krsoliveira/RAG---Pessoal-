# =============================================================
# RAG Pessoal — Variáveis de Ambiente
# =============================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env com credenciais reais.
# =============================================================

# -------------------------------------------------------------
# CREDENCIAIS GCP
# -------------------------------------------------------------

# Caminho para o arquivo JSON da Service Account do GCP.
# Coloque o arquivo na raiz do projeto (fora de javascript/).
# Exemplo: ../credentials_rag.json
GCP_VERTEX_CREDENTIALS_PATH=../credentials_rag.json

# ID do projeto no GCP (opcional — lido automaticamente do JSON da SA se omitido)
# GCP_PROJECT_ID=meu-projeto-gcp

# Região do Vertex AI Agent Builder
# Valores válidos: global, us-central1, eu (veja docs do Agent Builder)
GCP_LOCATION=global

# -------------------------------------------------------------
# CLOUD STORAGE
# -------------------------------------------------------------

# Nome do bucket no GCS onde os documentos serão armazenados
# Exemplo: meu-bucket-rag-documentos
GCP_STORAGE_BUCKET=

# -------------------------------------------------------------
# VERTEX AI AGENT BUILDER (DISCOVERY ENGINE)
# -------------------------------------------------------------

# ID do data store criado no Vertex AI Agent Builder
# Encontrado em: console.cloud.google.com > Agent Builder > Data Stores
# Formato: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GCP_VERTEX_DATA_STORE_ID=

# -------------------------------------------------------------
# GOOGLE DOCUMENT AI (OCR)
# -------------------------------------------------------------

# ID do processador Document AI para OCR de PDFs
# Crie em: console.cloud.google.com > Document AI > Processors
GCP_DOCUMENT_AI_PROCESSOR_ID=

# Localização do processador Document AI (us ou eu)
GCP_DOCUMENT_AI_LOCATION=us

# -------------------------------------------------------------
# CLOUD TASKS (ingestão assíncrona — apenas produção)
# -------------------------------------------------------------

# Nome da fila no Cloud Tasks
# Deixe em branco para desenvolvimento local (usará ingestão síncrona)
RAG_INGEST_TASKS_QUEUE=

# Região da fila do Cloud Tasks
# Exemplo: us-central1
RAG_INGEST_TASKS_LOCATION=

# URL do serviço Cloud Run que processa a ingestão em background
RAG_INGEST_WORKER_URL=

# Service Account com permissão para invocar o Cloud Run worker
RAG_INGEST_TASKS_SERVICE_ACCOUNT_EMAIL=

# -------------------------------------------------------------
# SERVIDOR
# -------------------------------------------------------------

# Porta em que o servidor Express vai escutar (padrão: 3000)
PORT=3000

# Nível de log: debug | info | warn | error (padrão: info)
LOG_LEVEL=info
